#!/bin/bash
set -euo pipefail

case "${UMANNI_DELIVERY_PREPARE_DATABASE:-}" in
  "" | 0)
    ;;
  1)
    printf '%s\n' 'delivery.startup.database_prepare_started'
    if ! bin/rails db:prepare >/dev/null 2>&1; then
      printf '%s\n' 'delivery.startup.database_prepare_failed'
      exit 1
    fi
    printf '%s\n' 'delivery.startup.database_prepare_succeeded'
    ;;
  *)
    printf '%s\n' 'delivery.startup.database_prepare_failed'
    exit 1
    ;;
esac

exec "$@"
